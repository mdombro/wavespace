; File: pdm_pdm_capture.pio

.define TRIGGER_PIN 5
.define CLK_PIN     4

.program pdm_clock
.side_set 1 opt       ; 1-bit sideset for clock (optional each instruction)

; Generates a continuous clock:
;   low for one instruction, high for one instruction.
; Effective bit rate:
;   bit_rate = (PIO clock) / (2 * clkdiv)

.wrap_target
    nop        side 0   ; clock low
    nop        side 1   ; clock high
.wrap


.program pdm_trigger_capture
.side_set 1 opt       ; optional sideset used as debug pin
; Capture program:
; - CPU pushes (bit_count - 1) via TX FIFO
; - Waits for trigger rising edge (GPIO defined by TRIGGER_PIN)
; - Captures that many bits from a PDM data pin (configured via IN base pin)
; - ISR pushes every 32 bits via push iffull

; Assumes:
;   - IN base pin is the PDM data pin (configured per-state-machine).

.wrap_target
    pull   block   side 0   ; OSR = (bit_count - 1), debug low while idle
    mov    x, osr          ; X = remaining bits

wait_for_low:
    wait   0 gpio TRIGGER_PIN side 0        ; ensure trigger pin is low first
wait_for_high:
    wait   1 gpio TRIGGER_PIN        ; wait for rising edge on trigger
    wait   0 gpio CLK_PIN            ; sync to clock low
    nop            side 1            ; drive debug pin high once triggered

capture_loop:
    ; there should  be a delay here for the datasheets spec of delay between clock low and valid data on the mic
    nop [2]
    in     pins, 1         ; sample PDM data on clock low
    push   iffull noblock  ; push 32-bit word when ISR fills, no gaps
    jmp    x-- continue_bits
    jmp    capture_done

continue_bits:
    wait   1 gpio CLK_PIN  ; wait for clock high
    wait   0 gpio CLK_PIN  ; wait for next falling edge
    jmp    capture_loop

capture_done:
    nop        side 0       ; drive debug pin low at end of capture
.wrap


.program trigger_wave
.side_set 1 opt

; Expectation: CPU pushes delay loop count, then duration (loop count) once at init.
; Program waits for trigger pin (configured via in_base) to go low->high.
; On rising edge, output pin (sideset) stays low for the delay loop count, then
; toggles for the requested number of loops.

pull   block
mov    isr, osr
pull   block
mov    y, osr

.wrap_target
wait   0 pin 0 side 0
wait   1 pin 0 side 0
mov    x, isr side 0
jmp    !x delay_done side 0
delay_loop:
    jmp x-- delay_loop side 0
delay_done:
mov    x, y side 0
jmp    !x tone_done side 0
loop:
    nop side 1
    nop side 0
    jmp x-- loop
tone_done:
nop side 0   ; why did this compile before??
.wrap

% c-sdk {

static inline void trigger_wave_program_init(PIO pio, uint sm, uint offset,
                                             float clk_div, uint trigger_pin,
                                             uint output_pin)
{
    pio_sm_set_consecutive_pindirs(pio, sm, trigger_pin, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, output_pin, 1, true);

    pio_sm_config c = trigger_wave_program_get_default_config(offset);
    sm_config_set_in_pins(&c, trigger_pin);
    sm_config_set_sideset_pins(&c, output_pin);

    pio_gpio_init(pio, trigger_pin);
    gpio_pull_down(trigger_pin);
    pio_gpio_init(pio, output_pin);

    sm_config_set_clkdiv(&c, clk_div);
    pio_sm_init(pio, sm, offset, &c);
}

%}
